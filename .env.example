# Copy this file to .env for local development. Never commit real credentials.
NODE_ENV=development
PORT=3001
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_TLS=false
# Set true only for the synthetic Free-tier remote demo; this sends DB traffic without TLS.
ALLOW_INSECURE_FALKORDB=false
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_GRAPH=official
SEED_FIXTURE=true
ENABLE_DEMO_WRITES=true
# Set true only when intentionally exposing the synthetic reviewer demo from Vercel.
ENABLE_PUBLIC_DEMO=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
